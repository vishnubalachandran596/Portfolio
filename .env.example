# Copy this file to .env and fill in real values for local development.
# On Vercel, set these as Project → Settings → Environment Variables instead.

# Postgres connection string for `docker compose up`.
# Host `db` is the Compose service in docker-compose.yml. User, password,
# and database name match POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB
# there (portfolio / portfolio / portfolio). Change them together or the
# app cannot sign in. This is the local Compose database, not production.
# To run `go run ./cmd/server` on the host against that same database,
# use localhost instead of db (Compose publishes port 5432).
DATABASE_URL=postgres://portfolio:portfolio@db:5432/portfolio?sslmode=disable
# Supabase sample — Project Settings → Database → Connection string →
# Connection pooling (port 6543, transaction mode). Replace the placeholders.
# Do not use the direct connection (port 5432 on *.supabase.co).
# DATABASE_URL=postgres://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Random long secret used to sign admin session cookies (JWT HS256).
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# Port for the standalone server (cmd/server). Not used on Vercel.
PORT=8080

# development | production. In production, session cookies are marked Secure.
APP_ENV=development

# Shown in <title> tags, hero copy fallback, and the footer.
SITE_NAME=Vishnu Balachandran

# Canonical site URL, used in canonical/OG tags and the sitemap. Strongly
# recommended once a custom domain is live and reachable on more than one
# host (e.g. both www.yourdomain.com and a bare subdomain both resolve):
# without this set, canonical/OG URLs are derived from whichever host
# actually served the request, so the same page can advertise a different
# "canonical" URL depending on how a visitor or crawler arrived — splitting
# ranking signals across hosts instead of consolidating them on one. Pick
# whichever host your apex domain actually redirects to (check with
# `curl -I https://yourdomain.com`) and use that here.
# Local Compose serves http://localhost:8080. Production on Vercel uses
# the live origin instead (https://www.vishnubalachandran.com).
SITE_URL=http://localhost:8080

# Bare domain (no scheme, no "www") to enable optional page-group
# subdomains (about./courses./...). www is always the canonical public
# host and is never redirected. Leave unset locally / before a custom
# domain exists.
DOMAIN=

# Razorpay (https://razorpay.com) powers paid-course checkout. Leave both
# unset to keep every course free — the purchase button only appears once
# both are set. Get these from Razorpay Dashboard → Settings → API Keys.
# Use TEST mode keys (rzp_test_...) until you've verified a full purchase
# end-to-end; switch to live keys (rzp_live_...) only when ready to accept
# real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin sign-in. ADMIN_BOOTSTRAP_EMAIL is added to the admin list on every
# start (and gets every course). ADMIN_BOOTSTRAP_PASSWORD is the admin
# password for /admin/login: it is compared with what is typed and is never
# stored anywhere, so changing it here (and redeploying) changes the
# password. Other admin emails use the same password. Signing in with Google
# as an admin email also gives admin access. In Vercel, add the password as
# a Sensitive variable.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-this-password

# Google OAuth ("Sign in with Google") — the only visitor login method.
# Create these at https://console.cloud.google.com/apis/credentials
# (APIs & Services → Credentials → Create Credentials → OAuth client ID →
# "Web application"). Add GOOGLE_REDIRECT_URL below as an authorized
# redirect URI in that same screen. Leave unset to show "not configured
# yet" on the login page rather than erroring.
# Paste the OAuth client id and secret. Leave them empty and the login
# page says Google is not configured yet. These are placeholders, not a
# real client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local placeholder. Must exactly match an authorized redirect URI on the
# OAuth client. Production uses the live origin plus the same path, e.g.
# https://www.vishnubalachandran.com/login/google/callback
# If PORT in this file is not 8080, change the port here too.
GOOGLE_REDIRECT_URL=http://localhost:8080/login/google/callback

# Telegram notification on every paid booking/course purchase — free, no
# business verification needed (unlike WhatsApp's Cloud API). Message
# @BotFather on Telegram, send /newbot, and copy the token it gives you.
# For the chat ID: message your new bot once, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates and read "chat":{"id":...}
# from the JSON. Leave both unset to disable notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local article HTML, course HTML, resume PDFs, profile photo, and site
# logo. Keep this directory outside the repo. Layout matches the Storage
# object paths:
#   articles/{slug}.html
#   courses/{slug}.html
#   resumes/default.pdf
#   resumes/{role-key}.pdf
#   profile/photo.{ext}
#   brand/logo.{ext}
# Docker Compose bind-mounts this host path at /content and sets
# LOCAL_CONTENT_DIR=/content inside the app container. `go run` on the
# host reads the path below as-is. Do not set LOCAL_CONTENT_DIR on Vercel.
# Production reads Supabase Storage instead.
LOCAL_CONTENT_DIR=../portfolio-local-content

# Private Supabase Storage for paid lesson HTML. The learn page streams
# the object after the purchase check. The browser never gets a file URL.
# SUPABASE_SECRET_KEY (service role, or an sb_secret_ key) is enough on
# its own. Without it, set the anon key plus the storage-reader login.
# That login's email must match the policy in
# core/db/migrations/055_course_content_object.sql
# (course-content@vishnubalachandran.com). It is not a visitor account.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_EMAIL=
SUPABASE_STORAGE_PASSWORD=

# Free-tier build.nvidia.com (NVIDIA NIM) API key for the RAG chatbot's
# embeddings (nvidia/nemotron-3-embed-1b) and chat completion
# (openai/gpt-oss-20b). Sign up free at https://build.nvidia.com -- no
# card required. The chatbot widget stays hidden on every page until
# this is set.
NVIDIA_API_KEY=

# Bearer token for:
#  - POST /api/chatbot/reindex -- lets a coding agent that edits course
#    /article content directly in Supabase (not through the admin UI)
#    force an immediate full chatbot reindex without an admin login.
#  - GET /internal/chatbot/cron-reindex -- the actual scheduled trigger
#    for the index-staleness problem a course/article save only flags
#    (see .github/workflows/chatbot-reindex.yml, which runs every 5
#    minutes and sends this same value as its Authorization header;
#    Vercel's own Cron Jobs only run once/day on the Hobby plan, too
#    infrequent for this, so a GitHub Actions schedule does the job
#    instead -- see docs/ARCHITECTURE.md). The GitHub Actions secret
#    named CHATBOT_REINDEX_TOKEN on this repo must hold the identical
#    value (Settings -> Secrets and variables -> Actions).
# Generate any random string (e.g. `openssl rand -hex 32`). Both
# endpoints return 404 until this is set. GET /internal/email/retry
# uses this same value. There is no separate email retry token and no
# GitHub Actions secret for email. The first send happens in the
# customer request. Vercel Cron calls the retry path once a day.
CHATBOT_REINDEX_TOKEN=

# Vercel Cron sends this as Authorization: Bearer on the daily email
# retry. Set it to the same value as CHATBOT_REINDEX_TOKEN. The app
# does not read this variable. Leave it empty locally.
CRON_SECRET=

# Transactional email. A provider sends only when its key is non-empty.
# Leave both empty for local Docker (log only). Set them in Vercel as
# Sensitive variables. Never commit real values.
# RESEND_API_KEY: sending access only. Course, software, article, and
# contribution mail from orders@, including a zero amount.
# BREVO_API_KEY: Brevo transactional API key (v3). Booking mail and
# consultancy connect requests from bookings@, and the newsletter
# confirmation from news@.
# From addresses and Reply-To are code constants, not environment variables.
# BCC and the admin send-test recipient are ADMIN_BOOTSTRAP_EMAIL.
RESEND_API_KEY=
BREVO_API_KEY=

# JDoodle compiler embeds for the course reader's Compiler drawer, one per
# language: "java=<key>,python=<key>,go=<key>". Create each embed (tied to
# a JDoodle project) in your JDoodle account and copy the key from its
# embed code (https://www.jdoodle.com/embed/v1/<key>). Leave empty to hide
# the Compiler button. Set it in Vercel as a Sensitive variable; never commit
# real values. Keys are not in page HTML: only course buyers (and admins)
# receive an embed address, when they open the compiler.
JDOODLE_EMBED_KEYS=

# Temple Accounts licence signing (Ed25519). Generate the pair at
# /admin/licences/keygen. LICENCE_SIGNING_KEY_B64 is the PRIVATE key
# (base64 of the 32-byte seed): set it in Vercel as a Sensitive variable
# and never commit a real value. LICENCE_KID is a short id (e.g. vb-2026-1)
# that must match the key id in the Temple repo's config/licence_keys.json,
# where the matching PUBLIC key goes. Licence issuing stays off until both
# are set.
LICENCE_SIGNING_KEY_B64=
LICENCE_KID=

# Cloudflare Turnstile (CAPTCHA) on contact, booking, newsletter and sign-up.
# Free. Create a widget at dash.cloudflare.com > Turnstile (hostnames:
# www.vishnubalachandran.com), then paste the two keys. Leave both empty to
# run without the challenge. The secret key stays in the host env only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
