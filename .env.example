# Copy this file to .env and fill in real values for local development.
# On Vercel, set these as Project → Settings → Environment Variables instead.

# Postgres connection string.
# Local Postgres (default below):
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio?sslmode=disable
# Supabase sample — Project Settings → Database → Connection string →
# Connection pooling (port 6543, transaction mode). Replace the placeholders.
# Do not use the direct connection (port 5432 on *.supabase.co).
# DATABASE_URL=postgres://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Random long secret used to sign admin session cookies (JWT HS256).
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# Port for the standalone server (cmd/server). Not used on Vercel.
PORT=8080

# development | production. In production, session cookies are marked Secure.
APP_ENV=development

# Shown in <title> tags, hero copy fallback, and the footer.
SITE_NAME=Vishnu Balachandran

# Canonical site URL, used in canonical/OG tags and the sitemap. Strongly
# recommended once a custom domain is live and reachable on more than one
# host (e.g. both www.yourdomain.com and a bare subdomain both resolve):
# without this set, canonical/OG URLs are derived from whichever host
# actually served the request, so the same page can advertise a different
# "canonical" URL depending on how a visitor or crawler arrived — splitting
# ranking signals across hosts instead of consolidating them on one. Pick
# whichever host your apex domain actually redirects to (check with
# `curl -I https://yourdomain.com`) and use that here.
SITE_URL=https://www.yourdomain.com

# Bare domain (no scheme, no "www") to enable optional page-group
# subdomains (about./courses./...). www is always the canonical public
# host and is never redirected. Leave unset locally / before a custom
# domain exists.
DOMAIN=

# Razorpay (https://razorpay.com) powers paid-course checkout. Leave both
# unset to keep every course free — the purchase button only appears once
# both are set. Get these from Razorpay Dashboard → Settings → API Keys.
# Use TEST mode keys (rzp_test_...) until you've verified a full purchase
# end-to-end; switch to live keys (rzp_live_...) only when ready to accept
# real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Currency for paid-course checkout (ISO 4217, e.g. USD, INR). Check that
# your Razorpay account is actually enabled for international payments
# before using a non-INR currency — many individual accounts start
# INR-only. Defaults to USD.
CHECKOUT_CURRENCY=USD

# One-time admin bootstrap: on startup, if no admin account exists yet,
# these create the first one (bcrypt-hashed). Safe to leave set afterwards
# — bootstrap is a no-op once an admin exists. Remove/rotate after first
# login for security.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-this-password

# Google OAuth ("Sign in with Google") — the only visitor login method.
# Create these at https://console.cloud.google.com/apis/credentials
# (APIs & Services → Credentials → Create Credentials → OAuth client ID →
# "Web application"). Add GOOGLE_REDIRECT_URL below as an authorized
# redirect URI in that same screen. Leave unset to show "not configured
# yet" on the login page rather than erroring.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI on the OAuth client, e.g.
# https://home.yourdomain.com/login/google/callback (or, before a custom
# domain, your *.vercel.app URL + the same path).
GOOGLE_REDIRECT_URL=

# Telegram notification on every paid booking/course purchase — free, no
# business verification needed (unlike WhatsApp's Cloud API). Message
# @BotFather on Telegram, send /newbot, and copy the token it gives you.
# For the chat ID: message your new bot once, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates and read "chat":{"id":...}
# from the JSON. Leave both unset to disable notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Private Supabase Storage for paid lesson HTML. The learn page streams
# the object after the purchase check. The browser never gets a file URL.
# SUPABASE_SECRET_KEY (service role, or an sb_secret_ key) is enough on
# its own. Without it, set the anon key plus the storage-reader login.
# That login's email must match the policy in
# core/db/migrations/055_course_content_object.sql
# (course-content@vishnubalachandran.com). It is not a visitor account.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_EMAIL=course-content@vishnubalachandran.com
SUPABASE_STORAGE_PASSWORD=
