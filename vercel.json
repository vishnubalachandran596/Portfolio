{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.go": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "vishnubalachandran.com" }],
      "destination": "https://www.vishnubalachandran.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "home.vishnubalachandran.com" }],
      "destination": "https://www.vishnubalachandran.com/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/internal/email/retry", "schedule": "0 3 * * *" }
  ]
}
